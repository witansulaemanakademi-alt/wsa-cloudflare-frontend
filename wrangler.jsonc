{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wsa-cloudflare-frontend",
  "main": "src/index.js",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
